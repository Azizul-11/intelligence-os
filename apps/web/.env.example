# Minimal Frontend — required configuration
#
# The orchestrator's own function URL. For local development against
# `supabase functions serve orchestrator`:
VITE_ORCHESTRATOR_URL=http://127.0.0.1:54321/functions/v1/orchestrator

# The Supabase project's PUBLIC anon key only. Never put a service-role key
# here - this file (and its .env.local counterpart) is bundled into the
# browser build.
VITE_SUPABASE_ANON_KEY=

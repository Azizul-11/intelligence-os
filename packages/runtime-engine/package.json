{
  "name": "@intelligence/runtime-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",

  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",

  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },

"scripts": {
  "build": "tsc -p tsconfig.json",
  "build:edge": "pnpm run build && pnpm exec esbuild src/index.ts --bundle --platform=neutral --format=esm --packages=external --outfile=edge/index.js",
  "typecheck": "tsc --noEmit -p tsconfig.json",
  "clean": "rm -rf dist edge"
},

"devDependencies": {
  "esbuild": "^0.28.1"
},

  "dependencies": {
    "@intelligence/domain-runtime": "workspace:*",
    "@intelligence/query-planner": "workspace:*",
    "@intelligence/semantic": "workspace:*",
    "@intelligence/sql-executor": "workspace:*"
  }
}
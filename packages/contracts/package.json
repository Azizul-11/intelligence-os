{
  "name": "@intelligence/contracts",
  "version": "0.1.0",
  "private": true,
  "description": "Shared platform contracts for IntelligenceOS",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
  ".": {
    "types": "./dist/index.d.ts",
    "import": "./dist/index.js"
  },
  "./semantic": {
    "types": "./dist/semantic/index.d.ts",
    "import": "./dist/semantic/index.js"
  }
},
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  }
}
{
  "name": "@intelligence/domain-runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",

  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",

  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },

  "scripts": {
  "build": "tsc -p tsconfig.json",
  "build:edge": "pnpm run build && pnpm exec esbuild src/index.ts --bundle --platform=neutral --format=esm --packages=external --outfile=edge/index.js",
  "clean": "rm -rf dist edge"
},

  "dependencies": {
    "@intelligence/domain-sdk": "workspace:*",
    "@intelligence/semantic": "workspace:*",
    "@intelligence/healthcare-domain": "workspace:*",
    "@intelligence/sql-template-resolver": "workspace:*"
  }
}
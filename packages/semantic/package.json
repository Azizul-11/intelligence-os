{
  "name": "@intelligence/semantic",
  "version": "0.1.0",
  "private": true,
  "description": "Semantic Engine for IntelligenceOS",
  "type": "module",

  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",

  "files": [
    "dist"
  ],

  "scripts": {
  "build": "tsc -p tsconfig.json",
  "build:edge": "pnpm run build && pnpm exec esbuild src/index.ts --bundle --platform=neutral --format=esm --packages=external --outfile=edge/index.js",
  "typecheck": "tsc --noEmit -p tsconfig.json",
  "clean": "rm -rf dist edge"
},

  "dependencies": {
    "@intelligence/contracts": "workspace:*",
    "@intelligence/domain-sdk": "workspace:*"
  },

  "devDependencies": {
    "typescript": "^5.9.2"
  }
}